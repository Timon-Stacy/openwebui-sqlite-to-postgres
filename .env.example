# Copy to .env and edit. One connection string drives the whole tool.

# --- Target PostgreSQL (schema already created by Open WebUI) ---------------
# Default matches the bundled lab `postgres` service (docker compose up -d postgres).
# Point it at your real Open WebUI PostgreSQL for an actual migration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/openwebui

# --- Source SQLite ----------------------------------------------------------
# Your existing Open WebUI database. Opened read-only; never modified.
SOURCE_SQLITE=/path/to/your/webui.db

# Working directory for the safe backup copy + logs.
WORK_DIR=./work

# --- Optional ---------------------------------------------------------------
# Rows fetched per batch while streaming.
BATCH_SIZE=5000

# Migrate only these tables (+ their foreign-key dependencies). Empty = all.
# KEEP_TABLES=chat,user,file

# Copy only the last N days of chats and everything attached to them.
# 0 (or unset) = migrate all data.
# RECENT_DAYS=7

# Skip the `backup` step and read SOURCE_SQLITE directly. Safe ONLY when
# Open WebUI is stopped (it must be anyway). Also skips the slow integrity check.
# SKIP_BACKUP=1
